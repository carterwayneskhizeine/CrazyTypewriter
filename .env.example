# API endpoint for sending messages (used by nginx proxy)
# The frontend will send POST requests to /api/messages which nginx will proxy here
VITE_POST_HOST=https://example.com

# Multi-device sync configuration
# Delay in milliseconds after typing stops before auto-syncing to server
# Default: 3000 (3 seconds)
VITE_SYNC_DEBOUNCE_MS=3000
